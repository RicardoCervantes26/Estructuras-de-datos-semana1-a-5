import java.util.ArrayList;
import java.util.Arrays;

public class InventarioRE7 {

    public static void main(String[] args) {

        // ==========================================================
        // 1. ESTRUCTURA ESTÁTICA: El Baúl de Objetos (Slot limitado)
        // ==========================================================
        System.out.println("--- BAÚL DE OBJETOS (ESTÁTICO) ---");
        // El baúl tiene espacios fijos definidos por el sistema
        String[] baul = new String[4]; 
        baul[0] = "Escopeta M21";
        baul[1] = "Manivela";
        baul[2] = "Llave de Escorpión";

        // SIMULACIÓN DE INSERCIÓN: Mover objetos para organizar
        // Queremos poner "Fluido Químico" en el slot 1 (desplazando el resto)
        System.out.println("-> Guardando Fluido Químico en el slot 1...");
        for (int i = 3; i > 1; i--) {
            baul[i] = baul[i - 1];
        }
        baul[1] = "Fluido Químico";

        // SIMULACIÓN DE ELIMINACIÓN: Sacar la Manivela (estaba en el slot 2)
        System.out.println("-> Sacando la Manivela del baúl...");
        baul[2] = null; 
        // Desplazamos para que no quede el hueco vacío en medio
        for (int i = 2; i < 3; i++) {
            baul[i] = baul[i + 1];
        }
        baul[3] = null;

        // RECORRIDO DEL BAÚL
        System.out.print("Slots ocupados en el Baúl: ");
        for (String item : baul) {
            if (item != null) System.out.print("[" + item + "] ");
        }
        System.out.println("\n");


        // ==========================================================
        // 2. ESTRUCTURA DINÁMICA: Inventario de Ethan (Con Mochilas)
        // ==========================================================
        System.out.println("--- INVENTARIO DE ETHAN (DINÁMICO) ---");
        ArrayList<String> inventarioEthan = new ArrayList<>();

        // Ethan empieza con lo básico
        inventarioEthan.add("Cuchillo");
        inventarioEthan.add("Pistola G17");
        inventarioEthan.add("Hierba");

        // INSERCIÓN REAL: Encuentras una Ganzúa y la guardas rápido
        System.out.println("-> Recogiste una Ganzúa.");
        inventarioEthan.add(1, "Ganzúa"); // Se inserta en la posición 1

        // ELIMINACIÓN REAL: Usas la Hierba para curarte
        System.out.println("-> Usaste la Hierba. (+ Salud)");
        inventarioEthan.remove("Hierba");

        // RECORRIDO DEL INVENTARIO
        System.out.println("Objetos en posesión:");
        for (String item : inventarioEthan) {
            System.out.println("- " + item);
        }

        // EL "ESPACIO ILIMITADO" (Simulando encontrar mochilas)
        System.out.println("\n-> ¡Encontraste una mochila! El inventario se expande.");
        inventarioEthan.add("Munición de Escopeta");
        inventarioEthan.add("Combustible");
        inventarioEthan.add("Cabeza de Perro Blanca");
        
        System.out.println("Total de objetos cargados: " + inventarioEthan.size());
    }
}

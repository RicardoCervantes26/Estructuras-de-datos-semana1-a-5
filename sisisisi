import java.util.LinkedList;
import java.util.PriorityQueue;

public class Main {

    // 1. IMPLEMENTACIÓN DE COLA USANDO ARREGLOS CIRCULARES (Munición en Tambor)
    static class ColaCircular {
        int[] slots;
        int frente, fin, tamano, capacidad;

        public ColaCircular(int capacidad) {
            this.capacidad = capacidad;
            slots = new int[capacidad];
            frente = 0;
            tamano = 0;
            fin = capacidad - 1;
        }

        public void enqueue(int bala) {
            if (tamano == capacidad) return;
            fin = (fin + 1) % capacidad;
            slots[fin] = bala;
            tamano++;
            System.out.println("-> Bala " + bala + " cargada en tambor.");
        }

        public int dequeue() {
            if (tamano == 0) return -1;
            int bala = slots[frente];
            frente = (frente + 1) % capacidad;
            tamano--;
            return bala;
        }
    }

    // 2. IMPLEMENTACIÓN DE COLA USANDO LISTAS ENLAZADAS (Fila de Enemigos)
    static class Nodo {
        String nombre;
        Nodo siguiente;
        Nodo(String nombre) { this.nombre = nombre; }
    }

    static class ColaListaEnlazada {
        Nodo frente, fin;

        public void enqueue(String enemigo) {
            Nodo nuevo = new Nodo(enemigo);
            if (fin == null) {
                frente = fin = nuevo;
            } else {
                fin.siguiente = nuevo;
                fin = nuevo;
            }
            System.out.println("-> " + enemigo + " ha aparecido.");
        }

        public String dequeue() {
            if (frente == null) return null;
            String nombre = frente.nombre;
            frente = frente.siguiente;
            if (frente == null) fin = null;
            return nombre;
        }
    }

    public static void main(String[] args) {

        // 4. PROBAR OPERACIONES ENQUEUE Y DEQUEUE

        // Prueba Cola Circular
        System.out.println("--- 1. COLA CIRCULAR (RECARGA) ---");
        ColaCircular revolver = new ColaCircular(3);
        revolver.enqueue(43);//Balas nomales
        revolver.enqueue(17);//Balas reforzadas
        System.out.println("Disparo bala: " + revolver.dequeue());

        // Prueba Lista Enlazada
        System.out.println("\n--- 2. COLA LISTA ENLAZADA (ENEMIGOS) ---");
        ColaListaEnlazada horda = new ColaListaEnlazada();
        horda.enqueue("Molded A");
        horda.enqueue("Molded B");
        System.out.println("Eliminado: " + horda.dequeue());

        // 3. IMPLEMENTAR COLA CON PRIORIDAD (Suministros de Emergencia)
        System.out.println("\n--- 3. COLA CON PRIORIDAD (SUMINISTROS) ---");
        PriorityQueue<String> suministros = new PriorityQueue<>();
        // Java ordena strings alfabéticamente; usamos números para forzar la prioridad
        suministros.add("2. Munición");
        suministros.add("1. Hierba Roja"); // Mayor prioridad
        suministros.add("3. Ganzúa");

        System.out.println("Usando prioridad: " + suministros.poll()); // Dequeue
        System.out.println("Siguiente en prioridad: " + suministros.poll());
    }
}
